{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PerformanceHub (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Quick run - starter dataset, no web app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--profile", "starter", "--no-serve"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
